{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    // Type-check only; tsconfig.build.json turns emit on.
    "noEmit": true,
    // No `baseUrl` (removed in TypeScript 7): paths resolve relative to this
    // file. tsc-alias rewrites them in the emitted JavaScript.
    "paths": {
      "@core/*": ["./src/core/*"],
      "@mcp/*": ["./src/mcp/*"],
      "@cli/*": ["./src/cli/*"],
      "@commands/*": ["./src/cli/commands/*"],
      "@linker/*": ["./src/cli/linker/*"],
      "@prompts": ["./src/cli/prompts/index.ts"],
      "@analyzer/*": ["./src/cli/analyzer/*"],
      "@config/*": ["./src/core/config/*"],
      "@storage/*": ["./src/core/storage/*"],
      "@wc-types/*": ["./src/core/types/*"],
      "@workspace/*": ["./src/core/workspace/*"]
    },
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["src", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
