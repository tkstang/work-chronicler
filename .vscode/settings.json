{
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/dist": true
  },
  "files.associations": {
    ".oxlintrc.json": "jsonc",
    ".oxfmtrc.json": "jsonc",
    "tsconfig.json": "jsonc",
    "tsconfig.build.json": "jsonc",
    "*.config.json": "jsonc"
  },
  "claudeCode.respectGitIgnore": false
}
