{
  "name": "work-chronicler",
  "version": "0.3.2",
  "description": "Gather, analyze, and summarize your work history from GitHub PRs and JIRA tickets for performance reviews and resumes",
  "type": "module",
  "bin": {
    "work-chronicler": "./bin/work-chronicler.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "cli": "tsx src/cli/index.ts",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "hooks": "node tools/git-hooks/manage-hooks.js",
    "hooks:disable-all": "node tools/git-hooks/manage-hooks.js disable-all",
    "hooks:enable-all": "node tools/git-hooks/manage-hooks.js enable-all",
    "hooks:status": "node tools/git-hooks/manage-hooks.js status",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "mcp": "tsx src/cli/index.ts mcp",
    "prepare": "test \"$GIT_HOOKS\" = \"0\" && exit 0; node tools/git-hooks/manage-hooks.js setup 2>/dev/null || true",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "type-check": "pnpm run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@octokit/graphql": "^9.0.5",
    "@octokit/rest": "^22.0.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^18.0.0",
    "gray-matter": "^4.0.3",
    "ora": "^10.0.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^22.20.0",
    "@vitest/ui": "^5.1.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.77.0",
    "oxlint": "^1.92.0",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "bin",
    ".agent"
  ],
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkstang/work-chronicler.git"
  },
  "keywords": [
    "cli",
    "github",
    "jira",
    "performance-review",
    "resume",
    "mcp",
    "ai"
  ],
  "author": "Thomas Stang",
  "license": "MIT",
  "main": "dist/cli/index.js",
  "types": "dist/cli/index.d.ts"
}
